{
  "name": "job-copilot",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @job-copilot/db db:generate",
    "db:migrate": "pnpm --filter @job-copilot/db db:migrate",
    "db:seed": "pnpm --filter @job-copilot/db db:seed",
    "apply:companion": "pnpm --filter @job-copilot/browser-apply companion"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
